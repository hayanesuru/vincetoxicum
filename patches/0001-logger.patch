diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
index 01f54a384580240649e65213199506cf30644e1d26643c22ac6dcea5fc1f62a6..27dd0c7923c6dc4b79d9f7c31de623ab7f2b0cc1c2b7e08b973393957123e2d0 100644
--- a/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/net/minecraft/server/dedicated/DedicatedServer.java
@@ -166,6 +166,22 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
 
     @Override
     protected boolean initServer() throws IOException {
+        // Haya start - logger
+        Thread flush = new Thread("logger") {
+            public void run() {
+                try {
+                    while (!DedicatedServer.this.isStopped() && DedicatedServer.this.isRunning()) {
+                        LogUtils.INSTANCE.flush();
+                        Thread.sleep(100L);
+                    }
+                } catch (InterruptedException e) {
+                    e.printStackTrace();
+                }
+            }
+        };
+        flush.setDaemon(true);
+        flush.start();
+        // Haya end - logger
         Thread consoleThread = new Thread("Server console handler") {
             @Override
             public void run() {
